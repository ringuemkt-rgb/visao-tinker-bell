{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visao-tinker-bell.local/schemas/red_flag.schema.json",
  "title": "VTB Risk Signal",
  "type": "object",
  "required": ["signal_id", "category", "title", "description", "evidence_ids", "method", "false_positive_risk", "status"],
  "properties": {
    "signal_id": {"type": "string", "minLength": 1},
    "category": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "severity": {"type": "string"},
    "entity_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "method": {"type": "string"},
    "threshold": {"type": "object"},
    "false_positive_risk": {"type": "string"},
    "alternative_explanations": {"type": "array", "items": {"type": "string"}},
    "legal_validation_required": {"type": "boolean"},
    "status": {"const": "ANOMALY_FOR_VERIFICATION"}
  },
  "additionalProperties": false
}
